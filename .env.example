# Copiá este archivo como .env.local (no se sube a git) y completá los valores.
# Todas las variables NEXT_PUBLIC_* quedan VISIBLES en el HTML/JS publicado:
# nunca pongas acá secretos (client secret de Google, X-API-Key del EATT, contraseñas).

# ID de cliente OAuth de Google (tipo "Aplicación web"). Paso a paso: docs/GOOGLE_AUTH.md
# Ejemplo: 1234567890-abcdefg.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=57217166408-a4fp0alheohnm5fnmn7kt0sbnsfn5b4l.apps.googleusercontent.com

# URL pública donde se publica el sitio (canonical, Open Graph, sitemap). Sin barra final.
# Desarrollo: http://localhost:3015  ·  Producción: https://<dominio-definitivo>
NEXT_PUBLIC_SITE_URL=http://localhost:3015

# Subcarpeta del servidor donde se publica (basePath). En desarrollo, vacía. En producción la define
# .github/workflows/deploy.yml (/waykipromos). Si la usás local, la app queda en http://localhost:3015/waykipromos/
NEXT_PUBLIC_BASE_PATH=

# URL del chatbot Wayki IA (EATT) que se muestra en la tab Wayki dentro de un iframe. Vacía → "muy pronto".
# Ese sitio tiene que permitir que lo muestren en un iframe (CSP frame-ancestors).
NEXT_PUBLIC_WAYKI_IA_URL=
